{
  "name": "nekofi",
  "version": "1.0.0",
  "private": true,
  "description": "Nekofi — AI-Powered Budget Tracker",
  "workspaces": [
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "mobile": "pnpm --filter mobile start",
    "mobile:ios": "pnpm --filter mobile ios",
    "mobile:android": "pnpm --filter mobile android",
    "lint": "pnpm --recursive run lint",
    "type-check": "pnpm --recursive run type-check",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "expo": "~51.0.28",
    "expo-clipboard": "~6.0.3",
    "react": "18.2.0",
    "react-native": "0.74.5"
  }
}
