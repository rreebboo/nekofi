{
  "expo": {
    "name": "Nekofi",
    "slug": "nekofi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nekofi",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0E2E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nekofi.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Nekofi uses your camera to scan receipts.",
        "NSPhotoLibraryUsageDescription": "Nekofi needs access to your photo library to upload receipts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F0E2E"
      },
      "package": "com.nekofi.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nekofi to access your camera to scan receipts."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "minSdkVersion": 26
          },
          "ios": {
            "newArchEnabled": true,
            "deploymentTarget": "13.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "apiBaseUrl": "",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "db0cbc0c-b20f-4147-a545-157606f87e3a"
      }
    },
    "owner": "rreebboos-organization"
  }
}
